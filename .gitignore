# Large data artifacts live in Zenodo, not git
*.parquet
*.zip
fetal_death_yearly_raw_*.zip
*.csv.gz
*.gz

# Raw NCHS source files (downloaded from FTP, not committed)
**/raw_data/*
!**/raw_data/.gitkeep
**/raw_docs/*
!**/raw_docs/.gitkeep

# Build outputs (yearly_clean parquets, harmonized/derived parquets, validation
# results). Symlinked from a sibling build dir; large derived artifacts that
# Zenodo carries authoritatively.
output/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Jupyter
.ipynb_checkpoints/

# Virtualenvs
.venv/
venv/
env/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Secrets & local configs
.env
.env.local
.claude/settings.local.json

# Copyrighted third-party reference articles — kept locally for Paper-2 work,
# never committed or published (the 11 tracked figure PDFs live in **/figures/).
/*.pdf

# Phase-E (Paper 2) Ananth-2022 replication scratch outputs — regenerable from
